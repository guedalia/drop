{
  "name": "Send to Claude",
  "short_name": "To Claude",
  "description": "Share files from the phone to the Claude inbox.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f4f5f7",
  "theme_color": "#c96442",
  "icons": [
    {"src": "icon_192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable"},
    {"src": "icon_512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable"}
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {"name": "files", "accept": ["*/*", "image/*", "video/*", "audio/*", "text/*", "application/*"]}
      ]
    }
  }
}
